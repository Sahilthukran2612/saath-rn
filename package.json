{
  "name": "saath-rn",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/mukta": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.61.0",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-qrcode-svg": "^6.3.32",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "private": true,
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/react-native": "^14.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lightningcss": "1.30.1",
    "postcss": "8.5.33",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "4.1.12"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|@rn-primitives/.*|nativewind|react-native-css|lucide-react-native))"
    ],
    "testTimeout": 30000,
    "setupFiles": [
      "./jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/worktrees/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.css$": "<rootDir>/jest.css.js",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}

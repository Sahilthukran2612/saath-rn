# Copy to .env and fill in. Leave both empty to run fully offline (the default).
# Use the project's API URL and its public "anon" key only. Never put a service_role key in the app.
# If the default supabase.co address is blocked on a network, put a custom domain or proxy here instead.
EXPO_PUBLIC_SAATH_API_URL=
EXPO_PUBLIC_SAATH_ANON_KEY=
